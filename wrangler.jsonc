// Cloudflare Pages config: serves the Vite build from
// bvandrc-project-template-react-frontend.pages.dev, deployed by
// .github/workflows/deploy.yml and previewed per PR by preview.yml.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bvandrc-project-template-react-frontend",
  "compatibility_date": "2026-11-01",
  "pages_build_output_dir": "./dist"
}
